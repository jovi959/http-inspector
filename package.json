{
  "name": "http-inspector",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently --kill-others-on-fail --names ui,service \"pnpm dev:ui\" \"pnpm dev:service\"",
    "dev:ui": "vite --host 127.0.0.1 --port 5173",
    "dev:service": "cargo run -p inspector-server --bin inspector-dev-server",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "check:dependencies": "dependency-cruiser --validate .dependency-cruiser.cjs src",
    "check:file-budgets": "node scripts/check-file-budgets.mjs",
    "check:rust-boundaries": "node scripts/check-rust-boundaries.mjs",
    "check:architecture": "pnpm lint && pnpm check:dependencies && pnpm check:file-budgets && pnpm check:rust-boundaries",
    "contracts:generate": "cargo run -p inspector-core --bin generate_contracts",
    "contracts:check": "cargo run -p inspector-core --bin generate_contracts -- --check",
    "test:model": "cargo test -p inspector-core",
    "test:replay": "cargo test -p inspector-server --test replay_application",
    "test:dataverse": "vitest run src/domain/dataverse/dataverseMap.test.ts",
    "tauri": "tauri"
  },
  "dependencies": {
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/language": "^6.12.4",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.8",
    "@lezer/highlight": "^1.2.3",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.14.9",
    "@tauri-apps/api": "^2.11.1",
    "jsonc-parser": "^3.3.1",
    "mermaid": "^11.16.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-resizable-panels": "^4.12.2",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "concurrently": "^10.0.4",
    "dependency-cruiser": "^18.2.0",
    "eslint": "^10.8.1",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}

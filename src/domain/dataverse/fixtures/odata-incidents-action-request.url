/saas/d365/v9.2/sample_records?$select=field_assignment,field_created_at,_field_owner,field_request_due_at,field_priority,field_request_started_at,_field_contractor_contact,field_request_assigned_at&$filter=field_generate_request%20eq%201000%20and%20relation_request/field_request_number%20ne%20null%20and%20relation_request/field_request_number%20ne%20''%20and%20relation_workflow/any(p:%20p/_field_stage%20ne%2022222222-3333-4444-8555-666666666666)%20and%20(field_assignment%20eq%202001%20or%20field_assignment%20eq%202002)%20and%20not%20relation_workflow/any(p:%20p/field_status%20ne%200)%20and%20contains(relation_owner/field_login,'TEST_USER')&$expand=relation_account(%20$select=field_account_id,field_name,field_account_number,%20field_trade),relation_contact(%20$select=field_contact_id,%20field_first_name,%20field_last_name),relation_location(%20$select=field_location_id,field_city,field_postal_code,field_country,field_latitude,%20field_location_name,field_longitude,field_region,field_address),relation_owner(%20$select=field_user_id,field_login),relation_team(%20$select=field_team_id,field_name),relation_workflow(%20$select=field_workflow_id,_field_stage,field_status),relation_request(%20$select=field_request_id,field_request_number,field_request_type,field_modified,%20field_issue,field_name%20;$expand=relation_center(%20$select=field_territory_id,field_description,field_name,field_center_number),relation_group(%20$select=field_team_id,field_name),)
